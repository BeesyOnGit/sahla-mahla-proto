# The only config file: copy to `.env` next to docker-compose.yml on the VPS and fill it in.
# Changing it then running `docker compose up -d` recreates the container with the new values.

# ── Ports (published on APP_BIND; point each domain's reverse proxy at them) ──
API_PORT=3111
CDN_PORT=4111
APP_PORT=5111
# APP_BIND=127.0.0.1

# ── Front end (written into the built ClientApp when the container starts) ──
VITE_API_URL=https://api.sahla.inovsoft.online
VITE_CDN_URL=https://cdn.sahla.inovsoft.online

# ── API (Serveur) ──
# Also used by the CDN to check tokens
TOKEN_ENCRIPTION_KEY=fdigfdfFSDFSDF@dfDFdsfqf
BILLING_ENCRIPTION_KEY=fdsfDFJSDFKFDJDSF
SERVER_DOMAIN=https://api.sahla.inovsoft.online
CDN_DOMAIN=https://cdn.sahla.inovsoft.online/cdn/resource
# Front-end URL, also the only origin allowed by CORS
APP_DOMAIN=https://sahla.inovsoft.online
SITE_URL=
ENVIRONEMENT=prod
VAT=0.19
# SMTP is disabled in the code (accounts are validated directly); only needed if it is turned back on
# SMTP_HOST=mail.sahla-mahla.com
# SMTP_USER=no-reply@sahla-mahla.com
# SMTP_PASS=
# Demo mode: creates a confirmed client and freelance account at startup
# and shows their login on the login page. Their password is reset on every restart.
DEMO_MODE=true
DEMO_PASSWORD=demo1234

# ── CDN (files live in the data volume mounted at /data, next to the database in /data/db) ──
MEDIA_SAVE_PATH=/data/Media
RESOURCES_SAVE_PATH=/data/Resources
WATERMARK_PATH=/data/CdnResources/watermarkLogo.png
SERVER_URL=https://cdn.sahla.inovsoft.online/cdn/media
SERVER_RESOURCES_URL=https://cdn.sahla.inovsoft.online/cdn/resources
